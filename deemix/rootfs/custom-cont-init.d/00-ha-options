#!/usr/bin/with-contenv bash
set -e

echo "[info] Applying Home Assistant options"

if [ ! -f /data/options.json ]; then
    echo "[error] Missing /data/options.json — is this app run by the Supervisor?"
    exit 1
fi

# Publish an environment variable to all S6 services (read via with-contenv)
set_env() {
    printf '%s' "${2}" > "/run/s6/container_environment/${1}"
    export "${1}=${2}"
}

# Custom environment variables from the add-on options (env_vars)
while IFS= read -r -d '' key && IFS= read -r value; do
    set_env "${key}" "${value}"
    echo "[info] env: ${key}=${value}"
done < <(jq -r '.env_vars[]? | "\(.name)\u0000\(.value // "")"' /data/options.json)

# --- Apply PUID/PGID to user abc (default 1000:1000) ---
if [ -n "${PUID}" ] && [ -n "${PGID}" ]; then
    echo "[info] PUID=${PUID}, PGID=${PGID} from env_vars"
else
    echo "[info] PUID/PGID not set or incomplete — using default 1000:1000"
    set_env "PUID" "1000"
    set_env "PGID" "1000"
fi
if ! id abc &>/dev/null; then
    echo "[error] User 'abc' not found. Base image may be corrupted."
    exit 1
fi
usermod -o -u "${PUID}" abc 2>/dev/null || true
groupmod -o -g "${PGID}" abc 2>/dev/null || true
if [ "${PUID}" != "0" ]; then
    chown -R abc:abc /config 2>/dev/null || echo "[warn] chown /config failed, continuing"
fi
echo "[info] PUID/PGID applied successfully"

# --- ОПЦИИ Telegram bot ---
TELEGRAM_ENABLED=$(jq -r '.telegram_enabled // "false"' /data/options.json 2>/dev/null || echo "false")
if [ "${TELEGRAM_ENABLED}" = "true" ]; then
    set_env "TELEGRAM_ENABLED" "${TELEGRAM_ENABLED}"

        # Основные настройки Telegram bot
        set_env "TELEGRAM_TOKEN" "$(jq -r '.telegram_token // ""' /data/options.json)"
        # Инициализация login.json при первом запуске
        LOGIN_FILE="/config/login.json"
        if [ ! -f "${LOGIN_FILE}" ]; then
            ARL_FROM_OPTIONS=$(jq -r '.deemix_arl // ""' /data/options.json)
            if [ -n "${ARL_FROM_OPTIONS}" ]; then
                echo "{\"arl\": \"${ARL_FROM_OPTIONS}\"}" > "${LOGIN_FILE}"
                echo "[info] Initialized login.json with ARL from options"
            fi
        fi
        
        # Установка ENV из login.json (или из options.json если файл пуст)
        ARL_FOR_ENV=""
        if [ -f "${LOGIN_FILE}" ]; then
            ARL_FOR_ENV=$(jq -r '.arl // empty' "${LOGIN_FILE}" 2>/dev/null)
        fi
        if [ -z "${ARL_FOR_ENV}" ] || [ "${ARL_FOR_ENV}" = "null" ]; then
            ARL_FOR_ENV=$(jq -r '.deemix_arl // ""' /data/options.json)
        fi
        set_env "DEEMIX_ARL" "${ARL_FOR_ENV}"
        set_env "DEEMIX_BITRATE_LOCK" "$(jq -r '.deemix_bitrate_lock // false' /data/options.json)"

        # Опциональные API ключи - подлежит удалению
        set_env "AUDD_API_KEY" "$(jq -r '.audd_api_key // ""' /data/options.json)"
        set_env "OPENAI_API_KEY" "$(jq -r '.openai_api_key // ""' /data/options.json)"
        set_env "WHISPER_URL" "$(jq -r '.whisper_url // ""' /data/options.json)"
        set_env "WHITELIST_ENABLED" "$(jq -r '.whitelist_enabled // false' /data/options.json)"
        set_env "WHITELIST_IDS" "$(jq -r '.whitelist_ids // ""' /data/options.json)"
        
        # Предупреждение о пустом белом списке (как в upstream) - позже удалить, когда телеграм бот будет логировать напрямую в аддон
        if [ "$(jq -r '.whitelist_enabled // false' /data/options.json)" = "true" ] && \
           [ -z "$(jq -r '.whitelist_ids // ""' /data/options.json)" ]; then
            echo "[warn] Whitelist is enabled but WHITELIST_IDS is empty. All users will be blocked until configured."
        fi

        # Внутренние настройки для работы в одном контейнере с deemix
        set_env "DEEMIX_SINGLE_USER" "true"
        set_env "USERS_FILE" "/config/telegram_bot/users.json"
        set_env "RUST_LOG" "info"

    echo "[info] Telegram bot enabled"
else
    echo "[info] Telegram bot disabled"
fi
# --- КОНЕЦ опций Telegram bot ---

# --- Инициализация config.json для Deemix (вне зависимости от Telegram bot) ---
SERVER_PORT=$(jq -r '.server_port // 6595' /data/options.json)
set_env "DEEMIX_SERVER_PORT" "${SERVER_PORT}"
set_env "DEEMIX_URL" "http://localhost:${SERVER_PORT}"
CONFIG_JSON="/config/config.json"
if [ ! -f "${CONFIG_JSON}" ]; then
    BITRATE_FROM_OPTIONS=$(jq -r '.deemix_bitrate // 9' /data/options.json | tr -d '"')
    if [ -n "${BITRATE_FROM_OPTIONS}" ] && [[ "${BITRATE_FROM_OPTIONS}" =~ ^[0-9]+$ ]]; then
        echo "{\"maxBitrate\": ${BITRATE_FROM_OPTIONS}}" > "${CONFIG_JSON}"
        echo "[info] Created config.json with maxBitrate=${BITRATE_FROM_OPTIONS}"
    fi
fi

# Установка ENV DEEMIX_BITRATE из config.json (или из options.json)
BITRATE_FOR_ENV=""
if [ -f "${CONFIG_JSON}" ]; then
    BITRATE_FOR_ENV=$(jq -r '.maxBitrate // empty' "${CONFIG_JSON}" 2>/dev/null)
fi
if [ -z "${BITRATE_FOR_ENV}" ] || [ "${BITRATE_FOR_ENV}" = "null" ]; then
    BITRATE_FOR_ENV=$(jq -r '.deemix_bitrate // 9' /data/options.json)
fi
set_env "DEEMIX_BITRATE" "${BITRATE_FOR_ENV}"

# Sync DEEMIX_MUSIC_DIR to config.json (env_vars takes precedence)
if [ -n "${DEEMIX_MUSIC_DIR:-}" ]; then
    CONFIG_FILE="/config/config.json"
    DESIRED="${DEEMIX_MUSIC_DIR%/}/"
    if [ -f "$CONFIG_FILE" ]; then
        CURRENT=$(jq -r '.downloadLocation // empty' "$CONFIG_FILE" 2>/dev/null || echo "")
        if [ "$CURRENT" != "$DESIRED" ]; then
            echo "[info] Syncing downloadLocation to ${DESIRED} (from env_vars)"
            jq --arg loc "$DESIRED" '.downloadLocation = $loc' "$CONFIG_FILE" > "${CONFIG_FILE}.tmp" && mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"
        fi
    fi
fi

echo "[info] Home Assistant options applied"
